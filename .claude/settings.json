{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pta-dev-gate.mjs session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pta-dev-gate.mjs pre-tool"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|NotebookEdit"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pta-dev-gate.mjs session-end"
          }
        ]
      }
    ]
  }
}
